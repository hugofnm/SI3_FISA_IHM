<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:gravity="center_horizontal"
    tools:context=".Screen7Fragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tah'L'Hess"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="Gagnes en efficacité\nen gardant ton appli\nà portée de main"
            android:textSize="24sp"
            android:gravity="center" />

        <ImageView
            android:layout_width="120dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/logo_anime_0000"
            android:scaleType="fitCenter" />

        <ImageView
            android:id="@+id/walletBadge"
            android:layout_width="200dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:src="@drawable/add_to_apple_wallet_badge"
            android:scaleType="fitCenter" />

    </LinearLayout>

</LinearLayout>
